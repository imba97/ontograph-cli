{
  "name": "ontograph-cli",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "description": "Entity-relationship knowledge graph CLI — add entities, relate them, and query the graph",
  "author": "imba97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:imba97/ontograph-cli.git"
  },
  "keywords": [
    "ontograph-cli",
    "knowledge-graph",
    "entity",
    "relationship",
    "cli"
  ],
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs"
    }
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "ontograph": "./bin/ontograph.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "scripts": {
    "stub": "unbuild --stub",
    "build": "unbuild",
    "release": "bumpp",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache",
    "prepare": "simple-git-hooks",
    "ontograph": "node bin/ontograph.mjs"
  },
  "dependencies": {
    "cac": "^7.1.0",
    "consola": "^3.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --cache --fix"
  }
}
